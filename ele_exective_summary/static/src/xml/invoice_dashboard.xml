<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ele_exective_summary.InvoiceDashboardTemplate">
        <div class="o_dashboard_container">
            <div class="dashboard_filter_bar">
                <div>
                    <h4>Financial &amp; Invoice Analytics</h4>
                    <div class="subtitle">Live filtered counts • Click cards</div>
                </div>
            </div>

            <div t-if="state.error" class="dash_error_banner">
                ⚠ Dashboard data could not be loaded: <t t-esc="state.error"/>
            </div>

            <div class="dash_filters_panel">
                <div class="dash_filter_field">
                    <label>Customer</label>
                    <select t-on-change="(ev) => this.onFilterChange('partner_id', ev)">
                        <option value="">All Customers</option>
                        <t t-foreach="state.filter_options.partners" t-as="p" t-key="p.id">
                            <option t-att-value="p.id" t-att-selected="state.filters.partner_id == p.id"><t t-esc="p.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Salesperson</label>
                    <select t-on-change="(ev) => this.onFilterChange('user_id', ev)">
                        <option value="">All Users</option>
                        <t t-foreach="state.filter_options.users" t-as="u" t-key="u.id">
                            <option t-att-value="u.id" t-att-selected="state.filters.user_id == u.id"><t t-esc="u.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Payment Status</label>
                    <select t-on-change="(ev) => this.onFilterChange('payment_state', ev)">
                        <option value="">Any Status</option>
                        <t t-foreach="state.filter_options.payment_states" t-as="p" t-key="p.id">
                            <option t-att-value="p.id" t-att-selected="state.filters.payment_state == p.id"><t t-esc="p.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Period</label>
                    <select t-on-change="(ev) => this.onFilterChange('date_preset', ev)">
                        <option value="all" t-att-selected="state.filters.date_preset == 'all'">All Time</option>
                        <option value="today" t-att-selected="state.filters.date_preset == 'today'">Today</option>
                        <option value="this_week" t-att-selected="state.filters.date_preset == 'this_week'">This Week</option>
                        <option value="this_month" t-att-selected="state.filters.date_preset == 'this_month'">This Month</option>
                        <option value="last_month" t-att-selected="state.filters.date_preset == 'last_month'">Last Month</option>
                        <option value="this_quarter" t-att-selected="state.filters.date_preset == 'this_quarter'">This Quarter</option>
                        <option value="this_year" t-att-selected="state.filters.date_preset == 'this_year'">This Year</option>
                        <option value="custom" t-att-selected="state.filters.date_preset == 'custom'">Custom Range</option>
                    </select>
                </div>
                <t t-if="state.filters.date_preset === 'custom'">
                    <div class="dash_filter_field">
                        <label>From</label>
                        <input type="date" t-att-value="state.filters.date_from" t-on-change="(ev) => this.onFilterChange('date_from', ev)"/>
                    </div>
                    <div class="dash_filter_field">
                        <label>To</label>
                        <input type="date" t-att-value="state.filters.date_to" t-on-change="(ev) => this.onFilterChange('date_to', ev)"/>
                    </div>
                </t>
                <div class="dash_filter_field dash_filter_reset">
                    <button class="dash_reset_btn" t-att-disabled="!hasActiveFilters" t-on-click="resetFilters">
                        <i class="fa fa-refresh"/> Reset
                    </button>
                </div>
            </div>

            <div class="dashboard_cards_grid">
                <div class="dash_card gradient grad_blue" t-on-click="() => this.openInvoiceAction('customer_invoice')">
                    <div class="card_icon"><i class="fa fa-file-text"/></div>
                    <div class="card_title">Total Invoices</div>
                    <div class="card_value"><t t-esc="state.total_invoices"/></div>
                    <div class="card_sub">Customer</div>
                </div>
                <div class="dash_card gradient grad_orange" t-on-click="() => this.openInvoiceAction('draft')">
                    <div class="card_icon"><i class="fa fa-pencil"/></div>
                    <div class="card_title">Draft</div>
                    <div class="card_value"><t t-esc="state.draft_invoices"/></div>
                    <div class="card_sub">Not posted</div>
                </div>
                <div class="dash_card gradient grad_indigo" t-on-click="() => this.openInvoiceAction('posted')">
                    <div class="card_icon"><i class="fa fa-check"/></div>
                    <div class="card_title">Posted</div>
                    <div class="card_value"><t t-esc="state.posted_invoices"/></div>
                    <div class="card_sub">Confirmed</div>
                </div>
                <div class="dash_card gradient grad_red" t-on-click="() => this.openInvoiceAction('unpaid')">
                    <div class="card_icon"><i class="fa fa-exclamation-circle"/></div>
                    <div class="card_title">Unpaid</div>
                    <div class="card_value"><t t-esc="state.unpaid_invoices"/></div>
                    <div class="card_sub">Outstanding</div>
                </div>
                <div class="dash_card gradient grad_green" t-on-click="() => this.openInvoiceAction('paid')">
                    <div class="card_icon"><i class="fa fa-money"/></div>
                    <div class="card_title">Paid</div>
                    <div class="card_value"><t t-esc="state.paid_invoices"/></div>
                    <div class="card_sub">Fully paid</div>
                </div>
                <div class="dash_card gradient grad_purple" t-on-click="() => this.openInvoiceAction('vendor_bill')">
                    <div class="card_icon"><i class="fa fa-truck"/></div>
                    <div class="card_title">Vendor Bills</div>
                    <div class="card_value"><t t-esc="state.bills_count"/></div>
                    <div class="card_sub">Supplier</div>
                </div>
                <div class="dash_card gradient grad_pink" t-on-click="() => this.openInvoiceAction('refund')">
                    <div class="card_icon"><i class="fa fa-undo"/></div>
                    <div class="card_title">Credit Notes</div>
                    <div class="card_value"><t t-esc="state.refunds_count"/></div>
                    <div class="card_sub">Refunds</div>
                </div>
                <div class="dash_card gradient grad_cyan" t-on-click="() => this.openInvoiceAction('vendor')">
                    <div class="card_icon"><i class="fa fa-building"/></div>
                    <div class="card_title">Vendors</div>
                    <div class="card_value"><t t-esc="state.vendors_count"/></div>
                    <div class="card_sub">Active</div>
                </div>
            </div>

            <div class="amount_row">
                <div class="dash_card gradient grad_green">
                    <div class="card_icon"><i class="fa fa-arrow-up"/></div>
                    <div class="card_title">Sales Amount</div>
                    <div class="card_value"><t t-esc="state.total_sale_amount"/></div>
                </div>
                <div class="dash_card gradient grad_teal">
                    <div class="card_icon"><i class="fa fa-check-circle"/></div>
                    <div class="card_title">Collected</div>
                    <div class="card_value"><t t-esc="state.payments_collected"/></div>
                </div>
                <div class="dash_card gradient grad_orange">
                    <div class="card_icon"><i class="fa fa-clock-o"/></div>
                    <div class="card_title">Residual</div>
                    <div class="card_value"><t t-esc="state.residual_amount"/></div>
                </div>
                <div class="dash_card gradient grad_red">
                    <div class="card_icon"><i class="fa fa-arrow-down"/></div>
                    <div class="card_title">Purchase Amount</div>
                    <div class="card_value"><t t-esc="state.total_purchase_amount"/></div>
                </div>
            </div>

            <div class="charts_row">
                <div class="chart_box">
                    <h5>Invoice Status</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="statusChart"/>
                    </div>
                </div>
                <div class="chart_box">
                    <h5>Collected vs Outstanding</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="paymentChart"/>
                    </div>
                </div>
            </div>

            <div class="charts_row">
                <div class="chart_box chart_full">
                    <h5>Financial Amounts Overview</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="amountChart"/>
                    </div>
                </div>
            </div>

            <div class="dashboard_footer_note">
                Live data from account.move • Charts powered by Chart.js
            </div>
        </div>
    </t>
</templates>
