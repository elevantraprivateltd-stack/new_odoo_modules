<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    on_create="quick_create"
                    quick_create_view="ele_helpdesk.view_helpdesk_ticket_quick_create_form"
                    sample="1">
                <field name="stage_id"/>
                <field name="name"/>
                <field name="priority"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="ticket_type_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_has_icon">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="ticket_type_id"/>
                                </div>
                                <div>
                                    <field name="partner_id"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_helpdesk_ticket_quick_create_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.quick_create</field>
        <field name="model">helpdesk.ticket</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" string="Ticket Subject" placeholder="e.g. Issue with Laptop"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="team_id"/>
                    <field name="priority" widget="priority"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" decoration-danger="is_overdue">
                <field name="ticket_ref"/>
                <field name="name"/>
                <field name="company" optional="show"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="ticket_type_id" optional="show"/>
                <field name="ticket_rating" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" optional="hide"/>
                <field name="stage_id"/>
                <field name="priority" widget="priority"/>
                <field name="user_id"/>
                <field name="is_overdue" optional="show" widget="boolean_toggle"/>
                <field name="create_date"/>
                <field name="close_date" string="Date of Solved" optional="hide"/>
                <field name="within_sla" optional="hide"/>
                <field name="after_sla" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_customer"
                                class="oe_stat_button" icon="fa-user"
                                invisible="not partner_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Customer</span>
                                <span class="o_stat_text">Page</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h6>
                            <field name="ticket_ref" readonly="1"/>
                        </h6>
                        <h1>
                            <field name="name" placeholder="Ticket Subject"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Reported By">
                            <field name="company"/>
                            <field name="reported_by"/>
                            <field name="designation"/>
                        </group>
                        <group string="Reporting">
                            <field name="create_date" string="Date of Reporting" readonly="1"/>
                            <field name="expected_time" readonly="1"/>
                            <field name="user_id" string="Assigned To"/>
                            <field name="time_remaining" readonly="1"/>
                            <field name="close_date" readonly="1"/>
                            <field name="within_sla" readonly="1"/>
                            <field name="after_sla" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="partner_email"/>
                            <field name="partner_phone"/>
                        </group>
                        <group string="Classification">
                            <field name="client_state" string="State"/>
                            <field name="issue_domain" string="Domain"/>
                            <field name="team_id"/>
                            <field name="ticket_type_id"/>
                            <field name="department"/>
                            <field name="source" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <group string="Priority">
                        <group>
                            <field name="impact"/>
                            <field name="urgency"/>
                        </group>
                        <group>
                            <field name="ticket_rating"/>
                            <field name="priority" widget="priority"/>
                            <field name="deadline"/>
                            <field name="is_overdue" readonly="1"/>
                            <field name="rating" string="Customer Rating (1-5)"/>
                        </group>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="mimetype"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="RCA">
                            <field name="rca"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Tickets">
                <field name="name"/>
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <filter string="My Tickets" name="my_tickets" domain="[('user_id','=',uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('user_id','=',False)]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue','=',True)]"/>
                <filter string="Within SLA" name="within_sla" domain="[('within_sla','=',True)]"/>
                <filter string="After SLA" name="after_sla" domain="[('after_sla','=',True)]"/>
                <group>
                    <filter string="Stage" name="group_stage" context="{'group_by':'stage_id'}"/>
                    <filter string="Team" name="group_team" context="{'group_by':'team_id'}"/>
                    <filter string="Agent" name="group_agent" context="{'group_by':'user_id'}"/>
                    <filter string="Ticket Type" name="group_type" context="{'group_by':'ticket_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="context">{'search_default_my_tickets': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Help Desk ticket</p>
        </field>
    </record>

    <record id="view_helpdesk_ticket_type_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.list</field>
        <field name="model">helpdesk.ticket.type</field>
        <field name="arch" type="xml">
            <list string="Ticket Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_helpdesk_ticket_type" model="ir.actions.act_window">
        <field name="name">Ticket Types</field>
        <field name="res_model">helpdesk.ticket.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>