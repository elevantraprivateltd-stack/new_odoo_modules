<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_vendor_po_summary" model="ir.ui.view">
        <field name="name">res.partner.form.vendor.po.summary</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Purchase Summary" name="vendor_po_summary">
                    <group>
                        <group>
                            <field name="vendor_po_total_count"/>
                            <field name="vendor_po_total_amount"/>
                        </group>
                    </group>
                    <field name="vendor_po_line_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="order_id" string="PO"/>
                            <field name="product_id"/>
                            <field name="product_qty" string="Ordered"/>
                            <field name="qty_received" string="Received"/>
                            <field name="qty_invoiced" string="Billed"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
