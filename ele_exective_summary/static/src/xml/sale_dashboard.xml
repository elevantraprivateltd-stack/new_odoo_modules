<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ele_exective_summary.SaleDashboardTemplate">
        <div class="o_dashboard_container">
            <div class="dashboard_filter_bar">
                <div>
                    <h4>Sales Executive Analytics</h4>
                    <div class="subtitle">Live filtered counts • Click cards for filtered records</div>
                </div>
            </div>

            <div t-if="state.error" class="dash_error_banner">
                ⚠ Dashboard data could not be loaded: <t t-esc="state.error"/>
            </div>

            <div class="dash_filters_panel">
                <div class="dash_filter_field">
                    <label>Sales Team</label>
                    <select t-on-change="(ev) => this.onFilterChange('team_id', ev)">
                        <option value="">All Teams</option>
                        <t t-foreach="state.filter_options.teams" t-as="t" t-key="t.id">
                            <option t-att-value="t.id" t-att-selected="state.filters.team_id == t.id"><t t-esc="t.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Salesperson</label>
                    <select t-on-change="(ev) => this.onFilterChange('user_id', ev)">
                        <option value="">All Users</option>
                        <t t-foreach="state.filter_options.users" t-as="u" t-key="u.id">
                            <option t-att-value="u.id" t-att-selected="state.filters.user_id == u.id"><t t-esc="u.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Status</label>
                    <select t-on-change="(ev) => this.onFilterChange('state', ev)">
                        <option value="">Any Status</option>
                        <t t-foreach="state.filter_options.states" t-as="s" t-key="s.id">
                            <option t-att-value="s.id" t-att-selected="state.filters.state == s.id"><t t-esc="s.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Period</label>
                    <select t-on-change="(ev) => this.onFilterChange('date_preset', ev)">
                        <option value="all" t-att-selected="state.filters.date_preset == 'all'">All Time</option>
                        <option value="today" t-att-selected="state.filters.date_preset == 'today'">Today</option>
                        <option value="this_week" t-att-selected="state.filters.date_preset == 'this_week'">This Week</option>
                        <option value="this_month" t-att-selected="state.filters.date_preset == 'this_month'">This Month</option>
                        <option value="last_month" t-att-selected="state.filters.date_preset == 'last_month'">Last Month</option>
                        <option value="this_quarter" t-att-selected="state.filters.date_preset == 'this_quarter'">This Quarter</option>
                        <option value="this_year" t-att-selected="state.filters.date_preset == 'this_year'">This Year</option>
                        <option value="custom" t-att-selected="state.filters.date_preset == 'custom'">Custom Range</option>
                    </select>
                </div>
                <t t-if="state.filters.date_preset === 'custom'">
                    <div class="dash_filter_field">
                        <label>From</label>
                        <input type="date" t-att-value="state.filters.date_from" t-on-change="(ev) => this.onFilterChange('date_from', ev)"/>
                    </div>
                    <div class="dash_filter_field">
                        <label>To</label>
                        <input type="date" t-att-value="state.filters.date_to" t-on-change="(ev) => this.onFilterChange('date_to', ev)"/>
                    </div>
                </t>
                <div class="dash_filter_field dash_filter_reset">
                    <button class="dash_reset_btn" t-att-disabled="!hasActiveFilters" t-on-click="resetFilters">
                        <i class="fa fa-refresh"/> Reset
                    </button>
                </div>
            </div>

            <div class="dashboard_cards_grid">
                <div class="dash_card gradient grad_blue" t-on-click="() => this.openSalesAction('all')">
                    <div class="card_icon"><i class="fa fa-shopping-cart"/></div>
                    <div class="card_title">Total Orders</div>
                    <div class="card_value"><t t-esc="state.total_orders"/></div>
                    <div class="card_sub">All</div>
                </div>
                <div class="dash_card gradient grad_orange" t-on-click="() => this.openSalesAction('quotation')">
                    <div class="card_icon"><i class="fa fa-file-text-o"/></div>
                    <div class="card_title">Quotations</div>
                    <div class="card_value"><t t-esc="state.quotations"/></div>
                    <div class="card_sub">Draft / Sent</div>
                </div>
                <div class="dash_card gradient grad_green" t-on-click="() => this.openSalesAction('confirmed')">
                    <div class="card_icon"><i class="fa fa-check-circle"/></div>
                    <div class="card_title">Confirmed</div>
                    <div class="card_value"><t t-esc="state.sale_confirmed"/></div>
                    <div class="card_sub">Sale state</div>
                </div>
                <div class="dash_card gradient grad_indigo" t-on-click="() => this.openSalesAction('to_invoice')">
                    <div class="card_icon"><i class="fa fa-file-invoice"/></div>
                    <div class="card_title">To Invoice</div>
                    <div class="card_value"><t t-esc="state.to_invoice"/></div>
                    <div class="card_sub">Ready</div>
                </div>
                <div class="dash_card gradient grad_teal" t-on-click="() => this.openSalesAction('invoiced')">
                    <div class="card_icon"><i class="fa fa-check-square"/></div>
                    <div class="card_title">Fully Invoiced</div>
                    <div class="card_value"><t t-esc="state.fully_invoiced"/></div>
                    <div class="card_sub">Done</div>
                </div>
                <div class="dash_card gradient grad_purple" t-on-click="() => this.openSalesAction('upsell')">
                    <div class="card_icon"><i class="fa fa-arrow-up"/></div>
                    <div class="card_title">Upselling</div>
                    <div class="card_value"><t t-esc="state.upsell"/></div>
                    <div class="card_sub">Opportunity</div>
                </div>
                <div class="dash_card gradient grad_red" t-on-click="() => this.openSalesAction('cancel')">
                    <div class="card_icon"><i class="fa fa-times-circle"/></div>
                    <div class="card_title">Cancelled</div>
                    <div class="card_value"><t t-esc="state.cancelled"/></div>
                    <div class="card_sub">Cancelled</div>
                </div>
                <div class="dash_card gradient grad_cyan" t-on-click="() => this.openSalesAction('customers')">
                    <div class="card_icon"><i class="fa fa-users"/></div>
                    <div class="card_title">Customers</div>
                    <div class="card_value"><t t-esc="state.customers_count"/></div>
                    <div class="card_sub">Active</div>
                </div>
            </div>

            <div class="amount_row">
                <div class="dash_card gradient grad_green">
                    <div class="card_icon"><i class="fa fa-dollar"/></div>
                    <div class="card_title">Total Confirmed Sales Amount</div>
                    <div class="card_value"><t t-esc="state.total_sales"/></div>
                    <div class="card_sub">Sum of amount_total</div>
                </div>
            </div>

            <div class="charts_row">
                <div class="chart_box">
                    <h5>Order Status Distribution</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="statusChart"/>
                    </div>
                </div>
                <div class="chart_box">
                    <h5>Invoice Status</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="invoiceChart"/>
                    </div>
                </div>
            </div>

            <div class="charts_row">
                <div class="chart_box chart_full">
                    <h5>Sales by Salesperson</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="spChart"/>
                    </div>
                </div>
            </div>

            <div class="dashboard_footer_note">
                Live data from sale.order • Charts by Chart.js • Click any KPI to open filtered list
            </div>
        </div>
    </t>
</templates>
