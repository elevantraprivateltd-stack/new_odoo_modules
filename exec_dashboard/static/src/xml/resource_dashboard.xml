<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="exec_dashboard.ResourceDashboardTemplate">
        <div class="o_dashboard_container">
            <div class="dashboard_filter_bar">
                <div>
                    <h4>Resource / Workforce Analytics</h4>
                    <div class="subtitle">HR Employee • Leave • Availability • Live filtered counts</div>
                </div>
            </div>

            <div t-if="state.error" class="dash_error_banner">
                ⚠ Dashboard data could not be loaded: <t t-esc="state.error"/>
            </div>

            <div class="dash_filters_panel">
                <div class="dash_filter_field">
                    <label>Department</label>
                    <select t-on-change="(ev) => this.onFilterChange('department_id', ev)">
                        <option value="">All Departments</option>
                        <t t-foreach="state.filter_options.departments" t-as="d" t-key="d.id">
                            <option t-att-value="d.id" t-att-selected="state.filters.department_id == d.id"><t t-esc="d.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Job Position</label>
                    <select t-on-change="(ev) => this.onFilterChange('job_id', ev)">
                        <option value="">All Positions</option>
                        <t t-foreach="state.filter_options.jobs" t-as="j" t-key="j.id">
                            <option t-att-value="j.id" t-att-selected="state.filters.job_id == j.id"><t t-esc="j.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field dash_filter_reset">
                    <button class="dash_reset_btn" t-att-disabled="!hasActiveFilters" t-on-click="resetFilters">
                        <i class="fa fa-refresh"/> Reset
                    </button>
                </div>
            </div>

            <div class="dashboard_cards_grid">
                <div class="dash_card gradient grad_blue" t-on-click="() => this.openResourceAction('employees')">
                    <div class="card_icon"><i class="fa fa-users"/></div>
                    <div class="card_title">Total Employees</div>
                    <div class="card_value"><t t-esc="state.total_employees"/></div>
                    <div class="card_sub">All records</div>
                </div>
                <div class="dash_card gradient grad_teal" t-on-click="() => this.openResourceAction('active')">
                    <div class="card_icon"><i class="fa fa-user-circle"/></div>
                    <div class="card_title">Active</div>
                    <div class="card_value"><t t-esc="state.active_employees"/></div>
                    <div class="card_sub">Active = True</div>
                </div>
                <div class="dash_card gradient grad_green">
                    <div class="card_icon"><i class="fa fa-check-circle"/></div>
                    <div class="card_title">Available</div>
                    <div class="card_value"><t t-esc="state.available_count"/></div>
                    <div class="card_sub">Active − Leave</div>
                </div>
                <div class="dash_card gradient grad_red" t-on-click="() => this.openResourceAction('leaves')">
                    <div class="card_icon"><i class="fa fa-plane"/></div>
                    <div class="card_title">On Leave</div>
                    <div class="card_value"><t t-esc="state.leave_count"/></div>
                    <div class="card_sub">Validated today</div>
                </div>
                <div class="dash_card gradient grad_orange" t-on-click="() => this.openResourceAction('departments')">
                    <div class="card_icon"><i class="fa fa-sitemap"/></div>
                    <div class="card_title">Departments</div>
                    <div class="card_value"><t t-esc="state.departments_count"/></div>
                    <div class="card_sub">HR depts</div>
                </div>
                <div class="dash_card gradient grad_cyan">
                    <div class="card_icon"><i class="fa fa-clock-o"/></div>
                    <div class="card_title">Checked-In</div>
                    <div class="card_value"><t t-esc="state.attendance_count"/></div>
                    <div class="card_sub">No checkout</div>
                </div>
                <div class="dash_card gradient grad_purple">
                    <div class="card_icon"><i class="fa fa-tasks"/></div>
                    <div class="card_title">Assigned Tasks</div>
                    <div class="card_value"><t t-esc="state.assigned_count"/></div>
                    <div class="card_sub">Open tasks</div>
                </div>
            </div>

            <div class="charts_row">
                <div class="chart_box">
                    <h5>Workforce Distribution</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="workforceChart"/>
                    </div>
                </div>
                <div class="chart_box">
                    <h5>Employees by Department</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="deptChart"/>
                    </div>
                </div>
            </div>

            <div class="dashboard_footer_note">
                Data from hr.employee + hr.leave • Available = Active − Currently on Leave • Charts by Chart.js
            </div>
        </div>
    </t>
</templates>
