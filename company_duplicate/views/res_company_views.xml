<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_duplicate" model="ir.ui.view">
        <field name="name">res.company.form.duplicate</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>

        <field name="arch" type="xml">

            <xpath expr="//form/sheet" position="inside">

                <group string="Company Clone">

                    <button
                        name="action_duplicate_company_setup"
                        string="Clone Master Data to New Company"
                        type="object"
                        class="btn-primary"
                    />

                </group>

            </xpath>

        </field>
    </record>

</odoo>
