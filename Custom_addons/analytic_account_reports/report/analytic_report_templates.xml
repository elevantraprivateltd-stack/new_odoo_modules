<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_analytic_account_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h2>Analytic Account Report</h2>
                        <table class="table table-sm" style="width:auto;">
                            <tr>
                                <td>
                                    <strong>Period:</strong>
                                </td>
                                <td>
                                    <span t-esc="o.date_from"/>
                                    to
                                    <span t-esc="o.date_to"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Company:</strong>
                                </td>
                                <td>
                                    <span t-esc="o.company_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Target Moves:</strong>
                                </td>
                                <td>
                                    <span t-esc="dict(o._fields['target_move'].selection).get(o.target_move)"/>
                                </td>
                            </tr>
                        </table>

                        <t t-set="report_data" t-value="o._get_report_data()"/>

                        <t t-if="not report_data">
                            <p class="text-muted">No analytic data found for the selected filters.</p>
                        </t>

                        <t t-foreach="report_data" t-as="group">
                            <p t-if="group.get('plan')" style="margin-bottom:0; font-size:11px; color:#1F4E78;">
                                <strong>Segment:</strong>
                                <span t-esc="group['plan']"/>
                            </p>
                            <h4 style="margin-top: 4px;">
                                <span t-esc="group['account'].display_name"/>
                            </h4>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Reference</th>
                                        <th>Partner</th>
                                        <th>General Account</th>
                                        <th class="text-end">Debit</th>
                                        <th class="text-end">Credit</th>
                                        <th class="text-end">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="group['lines']" t-as="line">
                                        <td>
                                            <span t-esc="line['date']"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['name']"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['partner']"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['general_account']"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="line['debit']"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="line['credit']"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="line['debit'] - line['credit']"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4">
                                            <strong>Total</strong>
                                        </td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-esc="group['total_debit']"
                                                      t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                            </strong>
                                        </td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-esc="group['total_credit']"
                                                      t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                            </strong>
                                        </td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-esc="group['total_amount']"
                                                      t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_analytic_account_pdf" model="ir.actions.report">
        <field name="name">Analytic Account Report</field>
        <field name="model">analytic.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">analytic_account_reports.report_analytic_account_document</field>
        <field name="report_file">analytic_account_reports.report_analytic_account_document</field>
        <field name="print_report_name">'Analytic Account Report - %s' % (object.company_id.name)</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- ================================================================
         Direct report: bound straight on account.analytic.account.
         Shows up as "Analytic Account PDF Report" under the record's
         Print menu (top of the form / list view), no wizard, always
         shows the complete data for the account.
    ================================================================= -->
    <template id="report_analytic_account_direct_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Lato', sans-serif;">
                        <t t-set="data" t-value="o._get_analytic_report_data()"/>
                        <t t-set="currency" t-value="o.company_id.currency_id or company.currency_id"/>

                        <!-- ============ TITLE BAND ============ -->
                        <div style="background-color:#ebe7c5; padding: 18px 22px; border-radius: 4px; margin-bottom: 4px;">
                            <div style="color:#FFFFFF; font-size: 22px; font-weight: 700; letter-spacing: 0.3px;">
                                <span t-esc="o.display_name"/>
                            </div>
                            <div style="color:#e2e3c3; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px;">
                                Analytic Account Statement
                            </div>
                        </div>

                        <!-- ============ SUBTITLE / META STRIP ============ -->
                        <table style="width:100%; border-collapse: collapse; margin-bottom: 18px;">
                            <tr>
                                <td style="background-color:#EDF2F7; border:1px solid #D8E1E8; padding: 10px 14px; width:25%;">
                                    <div style="font-size:9px; color:#7A8B99; text-transform:uppercase; letter-spacing:0.5px;">
                                        Period
                                    </div>
                                    <div style="font-size:14px; color:#1F4E78; font-weight:700;">
                                        <span t-esc="data['date_from'] or '-'"/> &#8594;
                                        <span t-esc="data['date_to'] or '-'"/>
                                    </div>
                                </td>
                                <td style="background-color:#EDF2F7; border:1px solid #D8E1E8; padding: 10px 14px; width:25%;">
                                    <div style="font-size:9px; color:#7A8B99; text-transform:uppercase; letter-spacing:0.5px;">
                                        Total Entries
                                    </div>
                                    <div style="font-size:14px; color:#1F4E78; font-weight:700;">
                                        <span t-esc="data['count']"/>
                                    </div>
                                </td>
                                <td style="background-color:#EDF2F7; border:1px solid #D8E1E8; padding: 10px 14px; width:25%;">
                                    <div style="font-size:9px; color:#7A8B99; text-transform:uppercase; letter-spacing:0.5px;">
                                        Company
                                    </div>
                                    <div style="font-size:14px; color:#1F4E78; font-weight:700;">
                                        <span t-esc="o.company_id.name or '-'"/>
                                    </div>
                                </td>
                                <td style="background-color:#EDF2F7; border:1px solid #D8E1E8; padding: 10px 14px; width:25%;">
                                    <div style="font-size:9px; color:#7A8B99; text-transform:uppercase; letter-spacing:0.5px;">
                                        Generated On
                                    </div>
                                    <div style="font-size:14px; color:#1F4E78; font-weight:700;">
                                        <span t-esc="data['generated_on']"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ============ KPI SUMMARY CARDS ============ -->
                        <!-- ============ SUBTITLE / META STRIP ============ -->
                        <table style="width:100%; border-collapse: collapse; margin-bottom: 18px;">
                            <tr>
                                <td style="background-color:#EDF2F7; border:1px solid #D8E1E8; padding: 10px 14px; width:20%;">
                                    <div style="font-size:9px; color:#7A8B99; text-transform:uppercase; letter-spacing:0.5px;">
                                        Period
                                    </div>
                                    <div style="font-size:14px; color:#1F4E78; font-weight:700;">
                                        <span t-esc="data['date_from'] or '-'"/> &#8594;
                                        <span t-esc="data['date_to'] or '-'"/>
                                    </div>
                                </td>
                                <td style="background-color:#EDF2F7; border:1px solid #D8E1E8; padding: 10px 14px; width:20%;">
                                    <div style="font-size:9px; color:#7A8B99; text-transform:uppercase; letter-spacing:0.5px;">
                                        Segment
                                    </div>
                                    <div style="font-size:14px; color:#1F4E78; font-weight:700;">
                                        <span t-esc="data['segment']"/>
                                    </div>
                                </td>
                                <td style="background-color:#EDF2F7; border:1px solid #D8E1E8; padding: 10px 14px; width:20%;">
                                    <div style="font-size:9px; color:#7A8B99; text-transform:uppercase; letter-spacing:0.5px;">
                                        Total Entries
                                    </div>
                                    <div style="font-size:14px; color:#1F4E78; font-weight:700;">
                                        <span t-esc="data['count']"/>
                                    </div>
                                </td>
                                <td style="background-color:#EDF2F7; border:1px solid #D8E1E8; padding: 10px 14px; width:20%;">
                                    <div style="font-size:9px; color:#7A8B99; text-transform:uppercase; letter-spacing:0.5px;">
                                        Company
                                    </div>
                                    <div style="font-size:14px; color:#1F4E78; font-weight:700;">
                                        <span t-esc="o.company_id.name or '-'"/>
                                    </div>
                                </td>
                                <td style="background-color:#EDF2F7; border:1px solid #D8E1E8; padding: 10px 14px; width:20%;">
                                    <div style="font-size:9px; color:#7A8B99; text-transform:uppercase; letter-spacing:0.5px;">
                                        Generated On
                                    </div>
                                    <div style="font-size:14px; color:#1F4E78; font-weight:700;">
                                        <span t-esc="data['generated_on']"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                        <!-- ============ TRANSACTIONS ============ -->
                        <div style="font-size:14px; font-weight:700; color:#1F4E78; margin-bottom:6px; padding-bottom:4px; border-bottom: 2px solid #1F4E78;">
                            Analytic Transactions
                        </div>

                        <t t-if="not data['lines']">
                            <p class="text-muted" style="margin-top:8px;">No analytic transactions found for this
                                account.
                            </p>
                        </t>

                        <t t-if="data['lines']">
                            <table class="table table-sm"
                                   style="width:100%; border-collapse: collapse; margin-top:8px;">
                                <thead>
                                    <tr style="background-color:#e2e3c3; color:#FFFFFF;">
                                        <th style="padding:6px 8px;">Date</th>
                                        <th style="padding:6px 8px;">Reference</th>
                                        <th style="padding:6px 8px;">Partner</th>
                                        <th style="padding:6px 8px;">General Account</th>
                                        <th class="text-end" style="padding:6px 8px;">Debit</th>
                                        <th class="text-end" style="padding:6px 8px;">Credit</th>
                                        <th class="text-end" style="padding:6px 8px;">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data['lines']" t-as="line"
                                        t-attf-style="background-color:#{'#FFFFFF' if line_index % 2 == 0 else '#F5F8FB'}; border-bottom:1px solid #E3E9EF;">
                                        <td style="padding:6px 8px;">
                                            <span t-esc="line['date']"/>
                                        </td>
                                        <td style="padding:6px 8px;">
                                            <span t-esc="line['name']"/>
                                        </td>
                                        <td style="padding:6px 8px;">
                                            <span t-esc="line['partner']"/>
                                        </td>
                                        <td style="padding:6px 8px;">
                                            <span t-esc="line['general_account']"/>
                                        </td>
                                        <td class="text-end" style="padding:6px 8px;">
                                            <span t-esc="line['debit']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td class="text-end" style="padding:6px 8px;">
                                            <span t-esc="line['credit']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td class="text-end" style="padding:6px 8px;">
                                            <span t-esc="line['balance']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr style="background-color:#e2e3c3; color:#FFFFFF;">
                                        <td colspan="4" style="padding:8px;">
                                            <strong>TOTAL</strong>
                                        </td>
                                        <td class="text-end" style="padding:8px;">
                                            <strong>
                                                <span t-esc="data['total_debit']"
                                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                            </strong>
                                        </td>
                                        <td class="text-end" style="padding:8px;">
                                            <strong>
                                                <span t-esc="data['total_credit']"
                                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                            </strong>
                                        </td>
                                        <td class="text-end" style="padding:8px;">
                                            <strong>
                                                <span t-esc="data['total_amount']"
                                                      t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>

                        <!-- ============ PROFIT & LOSS SUMMARY (SEGMENT FLOW) ============ -->
                        <div style="font-size:14px; font-weight:700; color:#1F4E78; margin: 26px 0 6px 0; padding-bottom:4px; border-bottom: 2px solid #1F4E78;">
                            Profit &amp; Loss Summary —
                            <span t-esc="data['segment']"/>
                        </div>
                        <table style="width:100%; border-collapse: collapse; margin-top:8px;">
                            <thead>
                                <tr style="background-color:#1F4E78; color:#FFFFFF;">
                                    <th style="padding:6px 8px; width:70%;"/>
                                    <th class="text-end" style="padding:6px 8px;">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['pl_summary']" t-as="pl_row"
                                    t-attf-style="background-color:#{'#EDF2F7' if pl_row['bold'] else ('#FFFFFF' if pl_row_index % 2 == 0 else '#F5F8FB')}; border-bottom:1px solid #E3E9EF;">
                                    <td t-attf-style="padding:7px 8px; #{'font-weight:700; color:#1F4E78;' if pl_row['bold'] else ''}">
                                        <span t-esc="pl_row['label']"/>
                                    </td>
                                    <td t-attf-style="padding:7px 8px; text-align:right; #{'font-weight:700; color:#1F4E78;' if pl_row['bold'] else ''}">
                                        <span t-esc="pl_row['value']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ============ BUDGET ITEMS ============ -->


                        <!-- ============ BUDGET ITEMS ============ -->
                        <t t-if="data['budget_items']">
                            <div style="font-size:14px; font-weight:700; color:#1F4E78; margin: 26px 0 6px 0; padding-bottom:4px; border-bottom: 2px solid #1F4E78;">
                                Budget Items
                            </div>
                            <table class="table table-sm"
                                   style="width:100%; border-collapse: collapse; margin-top:8px;">
                                <thead>
                                    <tr style="background-color:#B8860B; color:#FFFFFF;">
                                        <th style="padding:6px 8px;">Budget</th>
                                        <th style="padding:6px 8px;">Budgetary Position</th>
                                        <th style="padding:6px 8px;">Start Date</th>
                                        <th style="padding:6px 8px;">End Date</th>
                                        <th style="padding:6px 8px;">Paid Date</th>
                                        <th class="text-end" style="padding:6px 8px;">Planned</th>
                                        <th class="text-end" style="padding:6px 8px;">Practical</th>
                                        <th class="text-end" style="padding:6px 8px;">Theoretical</th>
                                        <th class="text-end" style="padding:6px 8px;">Achievement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data['budget_items']" t-as="bitem"
                                        t-attf-style="background-color:#{'#FFFFFF' if bitem_index % 2 == 0 else '#FBF6EA'}; border-bottom:1px solid #E3E9EF;">
                                        <td style="padding:6px 8px;">
                                            <span t-esc="bitem['budget']"/>
                                        </td>
                                        <td style="padding:6px 8px;">
                                            <span t-esc="bitem['budgetary_position']"/>
                                        </td>
                                        <td style="padding:6px 8px;">
                                            <span t-esc="bitem['date_from'] or '-'"/>
                                        </td>
                                        <td style="padding:6px 8px;">
                                            <span t-esc="bitem['date_to'] or '-'"/>
                                        </td>
                                        <td style="padding:6px 8px;">
                                            <span t-esc="bitem['paid_date'] or '-'"/>
                                        </td>
                                        <td class="text-end" style="padding:6px 8px;">
                                            <span t-esc="bitem['planned_amount']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td class="text-end" style="padding:6px 8px;">
                                            <span t-esc="bitem['practical_amount']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td class="text-end" style="padding:6px 8px;">
                                            <span t-esc="bitem['theoretical_amount']"
                                                  t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td class="text-end" style="padding:6px 8px;">
                                            <span t-esc="'%.2f' % bitem['percentage']"/>%
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_analytic_account_direct_pdf" model="ir.actions.report">
        <field name="name">Analytic Account PDF Report</field>
        <field name="model">account.analytic.account</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">analytic_account_reports.report_analytic_account_direct_document</field>
        <field name="report_file">analytic_account_reports.report_analytic_account_direct_document</field>
        <field name="print_report_name">'Analytic Account Report - %s' % (object.display_name)</field>
        <field name="binding_model_id" ref="analytic.model_account_analytic_account"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ================================================================
         Direct Excel export: server action bound the same way, so it
         appears right next to the PDF report under the same Print menu.
    ================================================================= -->
    <record id="action_server_analytic_account_excel" model="ir.actions.server">
        <field name="name">Analytic Account Excel Report</field>
        <field name="model_id" ref="analytic.model_account_analytic_account"/>
        <field name="binding_model_id" ref="analytic.model_account_analytic_account"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_analytic_excel_report()</field>
    </record>

</odoo>
