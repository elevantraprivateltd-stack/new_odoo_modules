<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_three_way" model="ir.ui.view">
        <field name="name">account.move.form.three.way</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="three_way_status not in ('waiting', 'exception')">
                    <strong>3-Way Matching: do not pay this bill yet.</strong>
                    <field name="three_way_status" invisible="1"/>
                    <field name="three_way_message" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-success mb-0" role="alert"
                     invisible="three_way_status != 'ready'">
                    <strong>3-Way Matching: ready to pay.</strong>
                    Ordered, received and billed quantities match.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
