<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_engagement" model="ir.ui.view">
        <field name="name">res.company.form.inherit.engagement</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Engagement Letter Layout">
                    <group>
                        <field name="engagement_letter_header_image" widget="image"/>
                        <field name="engagement_letter_footer_image" widget="image"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>