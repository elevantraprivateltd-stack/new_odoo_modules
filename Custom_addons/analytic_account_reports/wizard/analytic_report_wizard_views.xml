<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_analytic_report_wizard_form" model="ir.ui.view">
        <field name="name">analytic.report.wizard.form</field>
        <field name="model">analytic.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Analytic Account Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="target_move"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <group string="Filters">
                    <field name="plan_ids" widget="many2many_tags" nolabel="1"
                           placeholder="All Segments"/>
                    <field name="analytic_account_ids" widget="many2many_tags" nolabel="1"
                           placeholder="All analytic accounts"/>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object"
                            class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" string="Export XLSX" type="object"
                            class="btn-primary" icon="fa-file-excel-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_analytic_report_wizard" model="ir.actions.act_window">
        <field name="name">Analytic Account Report</field>
        <field name="res_model">analytic.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_analytic_report_wizard_form"/>
    </record>

    <menuitem id="menu_analytic_account_report_wizard"
              name="Analytic Account Report"
              parent="account.menu_finance_reports"
              action="action_analytic_report_wizard"
              sequence="50"/>

</odoo>