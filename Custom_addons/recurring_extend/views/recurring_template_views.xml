<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View for Server Model: account.recurring.template -->
    <record id="view_account_recurring_template_form_inherit" model="ir.ui.view">
        <field name="name">account.recurring.template.form.inherit</field>
        <field name="model">account.recurring.template</field>
        <field name="inherit_id" search="[('model', '=', 'account.recurring.template'), ('type', '=', 'form')]"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <notebook>
                    <page string="Expense Items Breakdown">
                        <field name="custom_line_ids">
                            <list editable="bottom">
                                <field name="name" string="Item / Expense Description"
                                       placeholder="e.g. Payroll, Rent, Utility"/>
                                <field name="account_id" string="Account"/>
                                <field name="amount" string="Amount"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- View for Payment Model -->
    <record id="view_account_recurring_payments_form_inherit_custom" model="ir.ui.view">
        <field name="name">account.recurring.payments.form.inherit.custom</field>
        <field name="model">account.recurring.payments</field>
        <field name="inherit_id" search="[('model', '=', 'account.recurring.payments'), ('type', '=', 'form')]"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <notebook>
                    <page string="Expense Items Breakdown">
                        <field name="payment_line_ids">
                            <list editable="bottom">
                                <field name="name" string="Item / Expense Description"
                                       placeholder="e.g. Payroll, Rent, Utility"/>
                                <field name="account_id" string="Account"/>
                                <field name="amount" string="Amount"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>