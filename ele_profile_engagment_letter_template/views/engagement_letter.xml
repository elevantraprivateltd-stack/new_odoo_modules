<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_engagement_checkbox" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.engagement.checkbox</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Ye xpath us page ke andar field dalega jahan engagement_letter_html hai -->
            <xpath expr="//field[@name='engagement_letter_html']" position="before">
                <field name="print_engagement_header_footer"
                       widget="boolean_toggle"
                       string="Print with Company Header/Footer"/>
            </xpath>
        </field>
    </record>
</odoo>