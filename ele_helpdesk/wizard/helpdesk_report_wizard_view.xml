<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_helpdesk_report_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.report.wizard.form</field>
        <field name="model">helpdesk.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Custom Report - Help Desk">
                <sheet>
                    <div class="oe_title">
                        <h1>Custom Ticket Report</h1>
                        <p class="text-muted">Select filters and generate your report</p>
                    </div>
                    <group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Filters">
                            <field name="team_id"/>
                            <field name="stage_id" widget="many2many_tags"/>
                            <field name="priority"/>
                            <field name="ticket_type_id"/>
                            <field name="department"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="only_overdue"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_pdf" string="Generate PDF Report"
                            type="object" class="btn-primary"/>
                    <button name="action_view_pivot" string="View Pivot / Graph"
                            type="object" class="btn-secondary"/>
                    <button name="action_view_list" string="View Ticket List"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_report_wizard" model="ir.actions.act_window">
        <field name="name">Custom Report</field>
        <field name="res_model">helpdesk.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[(6, 0, [ref('ele_helpdesk.group_helpdesk_user'), ref('ele_helpdesk.group_helpdesk_manager')])]"/>
    </record>

</odoo>
