<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ele_exective_summary.ProjectDashboardTemplate">
        <div class="o_dashboard_container">
            <div class="dashboard_filter_bar">
                <div>
                    <h4>Projects &amp; Tasks Analytics</h4>
                    <div class="subtitle">Live filtered counts • Click cards for records</div>
                </div>
            </div>

            <div t-if="state.error" class="dash_error_banner">
                ⚠ Dashboard data could not be loaded: <t t-esc="state.error"/>
            </div>

            <div class="dash_filters_panel">
                <div class="dash_filter_field">
                    <label>Project</label>
                    <select t-on-change="(ev) => this.onFilterChange('project_id', ev)">
                        <option value="">All Projects</option>
                        <t t-foreach="state.filter_options.projects" t-as="p" t-key="p.id">
                            <option t-att-value="p.id" t-att-selected="state.filters.project_id == p.id"><t t-esc="p.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Stage</label>
                    <select t-on-change="(ev) => this.onFilterChange('stage_id', ev)">
                        <option value="">All Stages</option>
                        <t t-foreach="state.filter_options.stages" t-as="s" t-key="s.id">
                            <option t-att-value="s.id" t-att-selected="state.filters.stage_id == s.id"><t t-esc="s.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Assigned User</label>
                    <select t-on-change="(ev) => this.onFilterChange('user_id', ev)">
                        <option value="">All Users</option>
                        <t t-foreach="state.filter_options.users" t-as="u" t-key="u.id">
                            <option t-att-value="u.id" t-att-selected="state.filters.user_id == u.id"><t t-esc="u.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dash_filter_field">
                    <label>Period</label>
                    <select t-on-change="(ev) => this.onFilterChange('date_preset', ev)">
                        <option value="all" t-att-selected="state.filters.date_preset == 'all'">All Time</option>
                        <option value="today" t-att-selected="state.filters.date_preset == 'today'">Today</option>
                        <option value="this_week" t-att-selected="state.filters.date_preset == 'this_week'">This Week</option>
                        <option value="this_month" t-att-selected="state.filters.date_preset == 'this_month'">This Month</option>
                        <option value="last_month" t-att-selected="state.filters.date_preset == 'last_month'">Last Month</option>
                        <option value="this_quarter" t-att-selected="state.filters.date_preset == 'this_quarter'">This Quarter</option>
                        <option value="this_year" t-att-selected="state.filters.date_preset == 'this_year'">This Year</option>
                        <option value="custom" t-att-selected="state.filters.date_preset == 'custom'">Custom Range</option>
                    </select>
                </div>
                <t t-if="state.filters.date_preset === 'custom'">
                    <div class="dash_filter_field">
                        <label>From</label>
                        <input type="date" t-att-value="state.filters.date_from" t-on-change="(ev) => this.onFilterChange('date_from', ev)"/>
                    </div>
                    <div class="dash_filter_field">
                        <label>To</label>
                        <input type="date" t-att-value="state.filters.date_to" t-on-change="(ev) => this.onFilterChange('date_to', ev)"/>
                    </div>
                </t>
                <div class="dash_filter_field dash_filter_reset">
                    <button class="dash_reset_btn" t-att-disabled="!hasActiveFilters" t-on-click="resetFilters">
                        <i class="fa fa-refresh"/> Reset
                    </button>
                </div>
            </div>

            <div class="dashboard_cards_grid">
                <div class="dash_card gradient grad_blue" t-on-click="() => this.openProjectAction('projects')">
                    <div class="card_icon"><i class="fa fa-folder"/></div>
                    <div class="card_title">Total Projects</div>
                    <div class="card_value"><t t-esc="state.total_projects"/></div>
                    <div class="card_sub">All</div>
                </div>
                <div class="dash_card gradient grad_teal" t-on-click="() => this.openProjectAction('open_projects')">
                    <div class="card_icon"><i class="fa fa-folder-open"/></div>
                    <div class="card_title">Open Projects</div>
                    <div class="card_value"><t t-esc="state.open_projects"/></div>
                    <div class="card_sub">Active</div>
                </div>
                <div class="dash_card gradient grad_orange" t-on-click="() => this.openProjectAction('tasks')">
                    <div class="card_icon"><i class="fa fa-list-alt"/></div>
                    <div class="card_title">Total Tasks</div>
                    <div class="card_value"><t t-esc="state.total_tasks"/></div>
                    <div class="card_sub">All tasks</div>
                </div>
                <div class="dash_card gradient grad_indigo" t-on-click="() => this.openProjectAction('open_tasks')">
                    <div class="card_icon"><i class="fa fa-hourglass-half"/></div>
                    <div class="card_title">Open Tasks</div>
                    <div class="card_value"><t t-esc="state.open_tasks"/></div>
                    <div class="card_sub">Not done</div>
                </div>
                <div class="dash_card gradient grad_green" t-on-click="() => this.openProjectAction('done_tasks')">
                    <div class="card_icon"><i class="fa fa-check-circle"/></div>
                    <div class="card_title">Done Tasks</div>
                    <div class="card_value"><t t-esc="state.done_tasks"/></div>
                    <div class="card_sub">Folded</div>
                </div>
                <div class="dash_card gradient grad_purple" t-on-click="() => this.openProjectAction('my_tasks')">
                    <div class="card_icon"><i class="fa fa-user"/></div>
                    <div class="card_title">My Tasks</div>
                    <div class="card_value"><t t-esc="state.my_tasks"/></div>
                    <div class="card_sub">Assigned to me</div>
                </div>
            </div>

            <div class="charts_row">
                <div class="chart_box">
                    <h5>Task Status Overview</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="taskChart"/>
                    </div>
                </div>
                <div class="chart_box">
                    <h5>Tasks by Stage</h5>
                    <div class="chart_canvas_wrap">
                        <canvas t-ref="stageChart"/>
                    </div>
                </div>
            </div>

            <div class="dashboard_footer_note">
                Live data from project.project &amp; project.task • Charts by Chart.js
            </div>
        </div>
    </t>
</templates>
