<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_helpdesk_custom" model="ir.actions.report">
        <field name="name">Helpdesk Custom Report</field>
        <field name="model">helpdesk.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ele_helpdesk.report_helpdesk_custom_document</field>
