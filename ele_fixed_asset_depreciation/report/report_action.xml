<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Asset Excel Report -->

    <record id="action_print_asset_excel" model="ir.actions.server">
        <field name="name">Fixed Asset Excel Report</field>
        <field name="model_id" ref="base_accounting_kit.model_account_asset_asset"/>
        <field name="binding_model_id" ref="base_accounting_kit.model_account_asset_asset"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_print_excel_report()
        </field>
    </record>


    <!-- Disposal Report -->
    <record id="action_print_asset_disposal_excel" model="ir.actions.server">
        <field name="name">Asset Disposal Excel Report</field>
        <field name="model_id" ref="base_accounting_kit.model_account_asset_asset"/>
        <field name="binding_model_id" ref="base_accounting_kit.model_account_asset_asset"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_print_disposal_excel_report()
        </field>
    </record>
</odoo>