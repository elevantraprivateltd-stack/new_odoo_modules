<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_inherit_planning_dates" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.planning.dates</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="planning_start_date"/>
                <field name="planning_end_date"/>
            </xpath>
        </field>
    </record>

    <record id="view_planning_schedule_form_v5" model="ir.ui.view">
        <field name="name">planning.schedule.form.v5</field>
        <field name="model">planning.schedule</field>
        <field name="arch" type="xml">
            <form string="Add Allocation">

                <header>
                    <button name="action_check_planning_validation"
                            type="object"
                            string="Check Validation"
                            class="btn-primary"/>
                </header>
                <sheet>


                    <div class="oe_title">
                        <label for="sale_order_id" string="Sale Order" class="oe_edit_only"/>
                        <h1>
                            <field name="sale_order_id"
                                   required="1"
                                   options="{'no_create': True}"
                                   domain="[('state', 'in', ['draft', 'sent', 'sale'])]"
                                   placeholder="Select Sale Order..."/>
                            <field name="sale_order_line_id" invisible="1"/>

                        </h1>
                    </div>
                    <group>
                        <group name="sale_order_allocation" string="Sale Order Allocation">
                            <field name="sale_order_line_id" string="Assignment Name"/>
                            <field name="name" invisible="1"/>
                            <field name="schedule_status"/>

                        </group>

                        <group string="Time &amp; Scale Metrics">
                            <field name="start_date" readonly="0"/>
                            <field name="end_date"
                                   invisible="recurrency"
                                   required="not recurrency"/>
                            <label for="allocated_time_pct" string="Allocated Hours"/>
                            <div class="o_row">
                                <field name="allocated_time_pct"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="rrule_type" invisible="1"/>

                            <label for="recurrency" string="Recurrent"/>
                            <div class="d-flex align-items-baseline gap-1">
                                <field name="recurrency" widget="boolean_toggle" options="{'autosave': False}"
                                       class="w-auto"/>
                                <span invisible="not recurrency" class="mx-1">Repeat:</span>
                                <field name="rrule_type_ui" class="w-auto o_input" invisible="not recurrency"
                                       required="recurrency"/>
                            </div>

                            <label for="interval" class="fw-bold text-900"
                                   invisible="not recurrency or rrule_type_ui != 'custom'"/>
                            <div class="d-flex gap-1" invisible="not recurrency or rrule_type_ui != 'custom'">
                                <field name="interval" string="Repeat every" class="oe_inline w-auto o_input_5ch"/>
                                <field name="rrule_type" nolabel="1" class="oe_inline"
                                       required="rrule_type_ui == 'custom'"/>
                            </div>

                            <span class="fw-bold text-nowrap"
                                  invisible="not recurrency or rrule_type_ui not in ['weekly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'weekly')">
                                Repeat on
                            </span>
                            <div invisible="not recurrency or rrule_type_ui not in ['weekly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'weekly')">
                                <widget name="calendar_week_days"/>
                            </div>

                            <label string="Day of Month" for="month_by" class="fw-bold text-900"
                                   style="width: fit-content;"
                                   invisible="rrule_type_ui not in ['monthly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'monthly')"/>
                            <div class="d-flex align-items-baseline gap-2"
                                 invisible="rrule_type_ui not in ['monthly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'monthly')">

                                <field name="month_by" nolabel="1" class="oe_inline"
                                       style="min-width:115px; width:115px;"
                                       required="rrule_type_ui == 'monthly' or rrule_type == 'monthly'"/>

                                <field name="day" nolabel="1" class="oe_inline w-auto"
                                       required="(rrule_type_ui == 'monthly' or rrule_type == 'monthly') and month_by == 'date'"
                                       invisible="month_by != 'date'"/>

                                <field name="byday" string="The" class="oe_inline w-auto" nolabel="1"
                                       required="(rrule_type_ui == 'monthly' or rrule_type == 'monthly') and month_by == 'day'"
                                       invisible="month_by != 'day'"/>

                                <field name="weekday" nolabel="1" class="oe_inline w-auto"
                                       required="(rrule_type_ui == 'monthly' or rrule_type == 'monthly') and month_by == 'day'"
                                       invisible="month_by != 'day'"/>

                                <field name="no_of_days"
                                       nolabel="1"
                                       class="oe_inline"
                                       style="width:45px; min-width:45px;"
                                       invisible="not recurrency or rrule_type_ui not in ['monthly','custom'] or (rrule_type_ui == 'custom' and rrule_type != 'monthly') or month_by != 'day'"/>
                            </div>
                            <label string="Until" for="end_type" class="fw-bold text-900" invisible="not recurrency"/>
                            <div class="d-flex gap-2" invisible="not recurrency">
                                <field name="end_type" class="oe_inline w-auto" nolabel="1" required="recurrency"/>
                                <field name="count" class="oe_inline w-auto" nolabel="1" invisible="end_type != 'count'"
                                       required="recurrency"/>
                                <field name="until" class="oe_inline w-auto" nolabel="1"
                                       invisible="end_type != 'end_date'"
                                       required="recurrency and end_type == 'end_date'"
                                       placeholder="e.g: 12/31/2023"
                                />
                            </div>

                            <field name="event_tz" invisible="not recurrency"/>
                        </group>
                    </group>
                    <group>
                        <group string="Allocation">
                            <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>

                        </group>
                    </group>

                    <notebook>
                        <page string="Employee Note" name="note">
                            <field name="description" placeholder="Additional note..."/>
                        </page>
                    </notebook>
                </sheet>

                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_planning_schedule_calendar_v5" model="ir.ui.view">
        <field name="name">planning.schedule.calendar.v5</field>
        <field name="model">planning.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Schedule by Resource"
                      date_start="start_date"
                      date_stop="end_date"
                      mode="month"
                      event_open_popup="true"
                      quick_create="false"
                      color="recurrence_group_id">
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_ids" filters="1" string="Resources"/>
                <field name="parent_schedule_id" invisible="1"/>
                <field name="recurrence_group_id" invisible="1"/>
            </calendar>
        </field>
    </record>
    <record id="view_planning_schedule_kanban_v5" model="ir.ui.view">
        <field name="name">planning.schedule.kanban.v5</field>
        <field name="model">planning.schedule</field>
        <field name="arch" type="xml">
            <kanban default_group_by="employee_ids" quick_create="false">
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click fw-bold text-primary">
                            <div>
                                <field name="name"/>
                            </div>
                            <div class="text-muted small mt-1">Project:
                                <field name="project_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_planning_schedule_list_v5" model="ir.ui.view">
        <field name="name">planning.schedule.list.v5</field>
        <field name="model">planning.schedule</field>
        <field name="arch" type="xml">
            <list string="Shift Schedules">
                <field name="name"/>
                <field name="employee_ids"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="view_planning_schedule_search_v8" model="ir.ui.view">
        <field name="name">planning.schedule.search.v8</field>
        <field name="model">planning.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Schedule">
                <field name="name"/>
                <field name="employee_ids"/>
                <field name="project_id"/>

                <filter name="my_shifts"
                        string="My Shifts"
                        domain="[('employee_ids', '=', uid)]"/>
                <separator/>
                <filter name="group_user"
                        string="Resource"
                        context="{'group_by': 'employee_ids'}"/>
                <filter name="group_project"
                        string="Project"
                        context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_planning_schedule_v5" model="ir.actions.act_window">
        <field name="name">Schedule Board Matrix</field>
        <field name="res_model">planning.schedule</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="domain">[('schedule_status', 'in', ['open', 'cancelled', 'deleted'])]</field>
        <field name="search_view_id" ref="view_planning_schedule_search_v8"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click on the schedule grid blocks to plan new shifts!
            </p>
        </field>
    </record>

    <menuitem id="menu_planning_root_v5"
              name="Service Planning"
              sequence="5"
              web_icon="service_planning,static/description/icon.png"/>
    <menuitem id="menu_planning_board_v5"
              name="Schedule Timeline"
              parent="menu_planning_root_v5"
              action="action_planning_schedule_v5"
              sequence="20"/>
</odoo>
