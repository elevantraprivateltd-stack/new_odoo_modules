<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="asset_dispose_view_form_inherit_custom" model="ir.ui.view">
        <field name="name">asset.dispose.view.form.inherit.custom</field>
        <field name="model">asset.dispose</field>
        <field name="inherit_id" ref="base_accounting_kit.asset_dispose_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_account_id']" position="after">
                <field name="buyer_name" invisible="disposal_type != 'sale'"/>
            </xpath>
        </field>
    </record>
</odoo>