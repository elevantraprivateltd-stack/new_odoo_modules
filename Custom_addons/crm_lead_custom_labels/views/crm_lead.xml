<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--  CRM Lead/Opportunity Form View - "Expected Closing" label override  -->
    <record id="crm_lead_view_form_custom_label" model="ir.ui.view">
        <field name="name">crm.lead.form.custom.label</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">Lead End Date</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="salesperson"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Lead Assigned To</attribute>
            </xpath>
        </field>
    </record>
    <!--  CRM Lead/Opportunity Form View - "Contacts" tab label override  -->
    <record id="crm_lead_view_form_custom_tab_label" model="ir.ui.view">
        <field name="name">crm.lead.form.custom.tab.label</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='lead']" position="attributes">
                <attribute name="string">Client Info</attribute>
            </xpath>
            <xpath expr="//group[field[@name='campaign_id'] and field[@name='medium_id'] and field[@name='source_id']]"
                   position="replace"/>
            <xpath expr="//group[@name='Misc']" position="replace"/>
        </field>
    </record>
    <record id="crm_lead_form_hide_marketing" model="ir.ui.view">
        <field name="name">crm.lead.form.hide.marketing</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[field[@name='campaign_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='lead']//field[@name='partner_name']/ancestor::group[1]" position="attributes">
                <attribute name="string">Institute Information</attribute>
            </xpath>

            <!-- Rename "Contact Information" -> "POC Information" -->
            <xpath expr="//page[@name='lead']//field[@name='contact_name']/ancestor::group[1]" position="attributes">
                <attribute name="string">POC Information</attribute>
            </xpath>

        </field>
    </record>


    <!-- CRM Lead/Opportunity Form View - "Lead Info" add new tab to crm  -->
    <record id="crm_lead_view_form_lead_info_tab" model="ir.ui.view">
        <field name="name">crm.lead.form.lead.info.tab</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Lead Info" name="lead_info">
                    <group>
                        <group string="Assignment Details">
                            <field name="lead_nature_of_assignment"/>
                            <field name="lead_scope_reference"/>
                            <field name="lead_assignment_expected_execution"/>
                            <field name="lead_proposal_submitted"/>
                            <field name="lead_comments"/>
                        </group>
                        <group string="Marketing">
                            <field name="campaign_id" options="{'create_name_field': 'title'}"/>
                            <field name="medium_id"/>
                            <field name="source_id"/>
                            <field name="referred"/>
                        </group>
                        <group string="Ownership">
                            <field name="team_id" options="{'no_open': True, 'no_create': True}"
                                   context="{'kanban_view_ref': 'sales_team.crm_team_view_kanban'}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>