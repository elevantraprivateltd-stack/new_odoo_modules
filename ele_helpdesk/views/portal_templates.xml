<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Adds a "Helpdesk Tickets" card to /my/home, same style as
         Your Orders / Your Invoices / Addresses. -->
    <template id="portal_my_home_menu_helpdesk"
              name="Portal layout : helpdesk ticket menu entries"
              inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/ele_helpdesk/static/src/img/icon-ticket.svg'"/>
                <t t-set="title">Helpdesk Tickets</t>
                <t t-set="text">Raise, follow or check the status of your support tickets</t>
                <t t-set="url" t-value="'/my/tickets'"/>
                <t t-set="placeholder_count" t-value="'ticket_count'"/>
            </t>
        </xpath>
    </template>

    <!-- /my/tickets - list of the logged-in customer's own tickets -->
    <template id="portal_my_tickets" name="My Tickets">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Helpdesk Tickets</t>
            </t>

            <div class="d-flex justify-content-end mb-3">
                <a href="/my/tickets/new" class="btn btn-primary">
                    <i class="fa fa-plus"/> New Ticket
                </a>
            </div>

            <t t-if="not tickets">
                <p class="alert alert-warning">You don't have any support tickets yet.</p>
            </t>
            <t t-else="">
                <table class="table table-hover o_portal_my_doc_table">
                    <thead>
                        <tr class="active">
                            <th>Incident #</th>
                            <th>Subject</th>
                            <th t-if="is_helpdesk_admin">Customer</th>
                            <th>Ticket Rating</th>
                            <th>Stage</th>
                            <th>Date of Reporting</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="tickets" t-as="ticket">
                            <td>
                                <a t-attf-href="/my/tickets/#{ticket.id}">
                                    <span t-esc="ticket.ticket_ref"/>
                                </a>
                            </td>
                            <td>
                                <a t-attf-href="/my/tickets/#{ticket.id}">
                                    <span t-esc="ticket.name"/>
                                </a>
                            </td>
                            <td t-if="is_helpdesk_admin"><span t-esc="ticket.partner_id.name"/></td>
                            <td><span t-esc="ticket.ticket_rating"/></td>
                            <td><span t-esc="ticket.stage_id.name"/></td>
                            <td><span t-esc="ticket.create_date"/></td>
                        </tr>
                    </tbody>
                </table>
                <t t-call="portal.pager"/>
            </t>
        </t>
    </template>

    <!-- /my/tickets/<id> - a single ticket's own "customer page".
         Only reachable by the customer that owns the ticket (see
         controllers/portal.py::portal_ticket_detail). -->
    <template id="portal_ticket_detail" name="My Ticket">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_back_in_edit_mode">
                <t t-set="backend_url" t-value="'/my/tickets'"/>
            </t>

            <div class="row">
                <div class="col-12">
                    <h3>
                        <span t-field="ticket.ticket_ref"/> - <span t-field="ticket.name"/>
                    </h3>
                    <table class="table table-borderless">
                        <tr>
                            <td class="text-muted">Stage</td>
                            <td><span t-field="ticket.stage_id.name"/></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Ticket Rating</td>
                            <td><span t-field="ticket.ticket_rating"/></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Date of Reporting</td>
                            <td><span t-field="ticket.create_date"/></td>
                        </tr>
                        <tr t-if="ticket.user_id">
                            <td class="text-muted">Assigned To</td>
                            <td><span t-field="ticket.user_id.name"/></td>
                        </tr>
                        <tr t-if="ticket.close_date">
                            <td class="text-muted">Closed On</td>
                            <td><span t-field="ticket.close_date"/></td>
                        </tr>
                    </table>
                    <h5>Description</h5>
                    <div t-field="ticket.description"/>
                </div>
            </div>
        </t>
    </template>

</odoo>
