<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_stock_status" model="ir.actions.report">
        <field name="name">Stock Status Report</field>
        <field name="model">stock.status.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_status_report.report_stock_status_document</field>
        <field name="report_file">stock_status_report.report_stock_status_document</field>
        <field name="print_report_name">'Stock Status Report - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
