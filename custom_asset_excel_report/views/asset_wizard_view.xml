<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_asset_report_wizard_form" model="ir.ui.view">
        <field name="name">asset.report.wizard.form</field>
        <field name="model">asset.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Asset Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print_report" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_asset_report_wizard" model="ir.actions.act_window">
        <field name="name">Print Asset Report</field>
        <field name="res_model">asset.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
            id="menu_asset_report_wizard"
            name="Asset Excel Report"
            parent="account.menu_finance_reports"
            action="action_asset_report_wizard"
            sequence="1"
            groups="account.group_account_user"/>
</odoo>